# Reference only: export these values, or set them in your hosting dashboard.
WORKFORCE_ENV=development
WORKFORCE_DATA=./data
PUBLIC_ORIGIN=http://localhost:8000
TRUST_PROXY=0
# In production PUBLIC_ORIGIN must be your exact HTTPS origin and uploads require scanning.
# DOCUMENT_SCANNER=clamscan --no-summary --fail-if-cvd-older-than=2 --alert-exceeds-max=yes

# Free remote pilot: keep these secrets in hosting environment variables, never in frontend code.
HOSTING_TIER=free
DATABASE_URL=postgresql://ROLE:ENCODED_PASSWORD@NEON_HOST/DATABASE?sslmode=require
# No object storage is required while document uploads are disabled.
# Optional future private storage:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# SUPABASE_BUCKET=workforce-documents
# Leave DOCUMENT_SCANNER unset for the free pilot. Production uploads remain disabled.
